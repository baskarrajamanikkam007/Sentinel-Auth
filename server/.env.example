# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway PostgreSQL add-on: copy the connection string from the Railway dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Redis ────────────────────────────────────────────────────────────────────
# Railway Redis add-on: copy host/port/password from the Railway dashboard
REDIS_HOST=redis.railway.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
# Free alternatives: Brevo (300 emails/day), Resend (100 emails/day)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=SentinelAuth <your@gmail.com>

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your Vercel client URL (no trailing slash)
CORS_ORIGIN=https://your-app.vercel.app

# ─── HaveIBeenPwned (optional) ────────────────────────────────────────────────
# Breach detection works without this key via k-anonymity API.
# Add a key from haveibeenpwned.com/API/Key for higher rate limits.
HIBP_API_KEY=
